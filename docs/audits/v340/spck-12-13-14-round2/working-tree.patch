+/**
+ * Automatically suggests evidence-backed Quick Tags when a student's project folder
+ * has verified code/model evidence. Never auto-suggests live presentation quality tags
+ * or unverified functional/hardware claims from mere document/slide file counts.
+ */
+export function suggestSpckQuickTagsFromProject(
+  input: SpckAutoSuggestInput
+): string[] {
+  const normalizedExts = Array.isArray(input.fileExtensions)
+    ? input.fileExtensions
+        .map((e) => String(e || "").trim().toLowerCase())
+        .filter(Boolean)
+    : [];
+  const nonDocExts = normalizedExts.filter((e) => !DOC_OR_SLIDE_ONLY_EXTS.has(e));
+  const hasPhotos = (input.screenshotCount || 0) > 0;
+  const hasVideos = (input.youtubeCount || 0) > 0;
+
+  if (
+    nonDocExts.length === 0 &&
+    !hasPhotos &&
+    !hasVideos &&
+    !input.hasFlexOrGridCss &&
+    !input.hasJsInteraction &&
+    !input.hasFirebaseCode &&
+    !input.hasRoboticsCode
+  ) {
+    return [];
+  }
+
+  const bundle = getSpckQuickTagGroups({
+    classId: input.classId,
+    courseName: input.courseName,
+    sessionNumber: input.sessionNumber,
+    fileExtensions: normalizedExts,
+  });
+
+  const progressGroup = bundle.groups.find((g) => g.id === "progress");
+  const nextStepGroup = bundle.groups.find((g) => g.id === "next_step");
+  const prodGroup = bundle.groups.find((g) => g.id === "product");
+  const suggested: string[] = [];
+
+  if (bundle.profile.track === "WEB") {
+    const hasCssEvidence =
+      Boolean(input.hasFlexOrGridCss) || nonDocExts.includes(".css");
+    const hasNavEvidence = Boolean(input.hasNavLinks);
+    const hasJsEvidence =
+      Boolean(input.hasJsInteraction) ||
+      nonDocExts.includes(".js") ||
+      nonDocExts.includes(".mjs");
+    const hasFirebaseEvidence = Boolean(input.hasFirebaseCode);
+
+    if (input.sessionNumber === 14) {
+      if (! prodGroup) return [];
+      if (bundle.profile.subTrack === "WEB_FIREBASE") {
+        if (hasFirebaseEvidence && prodGroup.tags[0]) suggested.push(prodGroup.tags[0]);
+        if (hasJsEvidence && prodGroup.tags[1]) suggested.push(prodGroup.tags[1]);
+      } else if (bundle.profile.subTrack === "WEB_JS") {
+        if (hasCssEvidence && prodGroup.tags[0]) suggested.push(prodGroup.tags[0]);
+        if (hasJsEvidence && prodGroup.tags[1]) suggested.push(prodGroup.tags[1]);
+      } else {
+        if (hasCssEvidence && prodGroup.tags[0]) suggested.push(prodGroup.tags[0]);
