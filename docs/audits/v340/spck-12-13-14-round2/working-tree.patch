+      if (hasNavEvidence && progressGroup?.tags[0]) suggested.push(progressGroup.tags[0]);
+      if (hasJsEvidence && progressGroup?.tags[1]) suggested.push(progressGroup.tags[1]);
+      if (hasCssEvidence && progressGroup?.tags[2]) suggested.push(progressGroup.tags[2]);
+      if ((hasCssEvidence || hasJsEvidence || hasNavEvidence) && nextStepGroup?.tags[0]) {
+        suggested.push(nextStepGroup.tags[0]);
+      }
+    }
+    return suggested;
+  }
+
+  if (bundle.profile.track === "ROBOTICS") {
+    const hasRoboticsCode =
