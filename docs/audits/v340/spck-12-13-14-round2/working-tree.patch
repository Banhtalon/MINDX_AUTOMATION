+        if (hasCssEvidence && progressGroup?.tags[0]) suggested.push(progressGroup.tags[0]);
+        if (hasJsEvidence && progressGroup?.tags[1]) suggested.push(progressGroup.tags[1]);
+        if ((hasCssEvidence || hasJsEvidence) && nextStepGroup?.tags[0]) {
+          suggested.push(nextStepGroup.tags[0]);
+        }
+      } else {
+        if (hasJsEvidence && progressGroup?.tags[0]) suggested.push(progressGroup.tags[0]);
+        if (hasJsEvidence && nextStepGroup?.tags[0]) suggested.push(nextStepGroup.tags[0]);
+      }
+      return suggested;
+    }
+
+    // WEB_BASIC
+    if (input.sessionNumber === 12) {
+      if (hasCssEvidence && progressGroup?.tags[0]) suggested.push(progressGroup.tags[0]);
+      if (hasNavEvidence && progressGroup?.tags[1]) suggested.push(progressGroup.tags[1]);
+      if ((hasCssEvidence || hasNavEvidence) && nextStepGroup?.tags[0]) {
+        suggested.push(nextStepGroup.tags[0]);
