+      if (hasPhotos && prodGroup.tags[0]) suggested.push(prodGroup.tags[0]);
+      if (hasRoboticsCode && prodGroup.tags[2]) suggested.push(prodGroup.tags[2]);
+      return suggested;
+    }
+
+    if (hasPhotos && progressGroup?.tags[0]) {
+      suggested.push(progressGroup.tags[0]);
+    }
+    if (
+      hasRoboticsCode &&
+      progressGroup?.tags[input.sessionNumber === 12 ? 2 : 1]
+    ) {
+      suggested.push(progressGroup.tags[input.sessionNumber === 12 ? 2 : 1]);
+    }
+    if (input.sessionNumber === 13 && hasVideos && progressGroup?.tags[2]) {
+      suggested.push(progressGroup.tags[2]);
+    }
+    if ((hasPhotos || hasRoboticsCode || hasVideos) && nextStepGroup?.tags[0]) {
+      suggested.push(nextStepGroup.tags[0]);
+    }
+    return suggested;
+  }
+
+  if (nonDocExts.length === 0) {
+    return [];
+  }
+
+  if (input.sessionNumber === 14) {
+    if (prodGroup?.tags[0]) suggested.push(prodGroup.tags[0]);
+    return suggested;
+  }
+
+  if (progressGroup?.tags[0]) suggested.push(progressGroup.tags[0]);
+  if (nextStepGroup?.tags[0]) suggested.push(nextStepGroup.tags[0]);
+  return suggested;
