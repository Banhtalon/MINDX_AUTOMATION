# ==========================================
# MINDX AUTOMATION BOT - ENVIRONMENT CONFIG
# ==========================================

# 1. Hệ thống Teaching (Quản lý Lịch dạy)
TEACHING_URL=https://teaching.mindx.edu.vn
TEACHING_USERNAME=your_teaching_email@mindx.edu.vn
TEACHING_PASSWORD=your_teaching_password

# 2. Hệ thống MindX LMS (Quản lý Lớp, Học viên, Chấm bài & SPCK)
LMS_URL=https://lms.mindx.edu.vn
LMS_USERNAME=your_lms_email@mindx.edu.vn
LMS_PASSWORD=your_lms_password

# (Tùy chọn: Nếu Teaching và LMS dùng chung 1 tài khoản/mật khẩu, có thể dùng 2 dòng dưới)
# MINDX_USERNAME=your_email@mindx.edu.vn
# MINDX_PASSWORD=your_password

# 3. Google Gemini AI Engine
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# 4. Playwright & Trình duyệt
HEADLESS_MODE=false

# 5. Bảo mật Cục bộ - Danh sách thư mục được phép đọc khi quét SPCK (phân cách bằng dấu chấm phẩy ;)
ALLOWED_LOCAL_DIRS=D:\SPCK_MindX;F:\MINDX_project test;C:\Users
